# --- Fonts ---
font-family = "JetBrainsMono Nerd Font"
font-size = 10
font-thicken = true

# --- Window  Size---
window-width = 160
window-height = 35

# --- Ligature ---
font-feature = calt
font-feature = liga

# --- Theme ---
# Commands: ghostty +list-themes
theme = hatsunemiku

# --- Window and Opacity ---
background-opacity = 1
background-blur-radius = 20

# --- Padding inside window ---
window-padding-x = 12
window-padding-y = 12

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# --- Tabs and Splits ---
window-save-state = default
focus-follows-mouse = false

# --- Shortcuts ---
keybind = super+t=new_tab
keybind = super+c=close_tab

# --- Splits ---
keybind = super+z=new_split:right
keybind = super+shift+z=new_split:down

# --- Close surface ---
keybind = super+shift+c=close_surface

# --- Switching beteween splits ---
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

# --- Different ---
copy-on-select = true
window-theme = dark
