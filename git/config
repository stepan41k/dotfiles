[pull]
       	rebase = false

[init]
      		defaultBranch = "main"

[diff]
       	external = difft
       	algorithm = "histogram"
       	colorMoved = "plain"
       	renames = true

[fetch]
       	all = true
       	prune = true

[merge]
       	conflictStyle = "zdiff3"

[pull]
       	ff = "only"

[push]
       	autoSetupRemote = true
       	default = "simple"
      		followTags = true

[rebase]
       	autoSquash = true
