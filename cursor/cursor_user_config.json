{
	"editor.unicodeHighlight.nonBasicASCII": false,
	"go.toolsManagement.autoUpdate": true,
	"git.autofetch": true,
	"editor.fontFamily": "JetBrains Mono",
	"editor.fontLigatures": true,
	"workbench.colorTheme": "Tokyo Night Storm",
	"editor.formatOnPaste": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"prettier.useTabs": true,
	"prettier.semi": false,
	"prettier.jsxSingleQuote": true,
	"prettier.singleQuote": true,
	"prettier.arrowParens": "avoid",
	"editor.fontSize": 14,
	"terminal.integrated.fontSize": 9,
	"terminal.integrated.defaultProfile.windows": "PowerShell",
	"breadcrumbs.icons": false,
	"breadcrumbs.showKeys": false,
	"breadcrumbs.showFiles": false,
	"breadcrumbs.symbolPath": "off",
	"breadcrumbs.showArrays": false,
	"breadcrumbs.showBooleans": false,
	"breadcrumbs.showClasses": false,
	"breadcrumbs.showConstants": false,
	"breadcrumbs.showConstructors": false,
	"breadcrumbs.showEnumMembers": false,
	"breadcrumbs.showEvents": false,
	"breadcrumbs.showFields": false,
	"breadcrumbs.showEnums": false,
	"breadcrumbs.showFunctions": false,
	"breadcrumbs.showInterfaces": false,
	"breadcrumbs.showMethods": false,
	"breadcrumbs.showModules": false,
	"breadcrumbs.showNamespaces": false,
	"breadcrumbs.showNull": false,
	"breadcrumbs.showNumbers": false,
	"breadcrumbs.showObjects": false,
	"breadcrumbs.showOperators": false,
	"breadcrumbs.showPackages": false,
	"breadcrumbs.showProperties": false,
	"breadcrumbs.showStrings": false,
	"breadcrumbs.showStructs": false,
	"breadcrumbs.showTypeParameters": false,
	"breadcrumbs.showVariables": false,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.enabled": true,
	"editor.lineDecorationsWidth": 16,
	"protoc": {
		"path": "D:/Code/Protoc/bin",
		"options": [
			"--proto_path=protos/v3",
			"--proto_path=protos/v2",
			"--proto_path=${env.GOPATH}/src"
		]
	},
	"editor.wordWrap": "on",
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"editor.tabSize": 4,
	"editor.formatOnSave": true,
	"explorer.compactFolders": false,
	"editor.smoothScrolling": true,
	"workbench.list.smoothScrolling": true,
	"terminal.integrated.smoothScrolling": true,
	"editor.cursorBlinking": "expand",
	"terminal.integrated.cursorBlinking": true,
	"editor.glyphMargin": false,
	"editor.linkedEditing": true,
	"editor.padding.top": 10,
	"files.defaultLanguage": "go",
	"[go]": {
		"editor.defaultFormatter": "golang.go"
	},
	"editor.fontWeight": "normal",
	"makefile.configureOnOpen": false,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
		"*.sqlite": "${capture}.${extname}-*",
		"*.db": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.sdb": "${capture}.${extname}-*",
		"*.s3db": "${capture}.${extname}-*"
	},
	"workbench.tree.indent": 16,
	"mssql.enableRichExperiences": true,
	"Prettier-SQL.SQLFlavourOverride": "postgresql",
	"[sql]": {
		"editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
	},
	"[yaml]": {
		"editor.tabSize": 4
	},
	"[yml]": {
		"editor.tabSize": 4
	},
	"dart.sdkPath": "C:\\tools\\dart-sdk",
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"docker.extension.enableComposeLanguageServer": false,
	"github.copilot.nextEditSuggestions.enabled": false,
	"vsicons.dontShowNewVersionMessage": true,
	"github.copilot.enable": {
		"*": false,
		"plaintext": false,
		"markdown": false,
		"scminput": false,
		"go": false,
		"sql": false
	},
	"workbench.editor.empty.hint": "hidden",
	"terminal.integrated.stickyScroll.enabled": false,
	"dart.flutterSdkPath": "D:\\Projects\\Flutter\\flutter",
	"workbench.iconTheme": "vscode-icons",
	"files.autoSave": "afterDelay",
	"cursor.cpp.disabledLanguages": [
		"plaintext",
		"markdown",
		"scminput",
		"go",
		"sql",
		"dockercompose",
		"worktree-sql"
	],
	"vs-kubernetes": {
		"vscode-kubernetes.helm-path-linux": "/home/stepan41k/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
		"vscode-kubernetes.kubectl-path-linux": "/home/stepan41k/.local/state/vs-kubernetes/tools/kubectl/kubectl",
		"vscode-kubernetes.minikube-path-linux": "/home/stepan41k/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube"
	}
}
