{
    // Panels
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "project_panel": {
        "dock": "left",
        "default_width": 300,
        "auto_fold_dirs": false,
        "indent_size": 18,
        "starts_open": false,
    },

    // Scrollbar
    "scrollbar": {
        "show": "auto",
        "cursors": false,
        "git_diff": false,
        "search_results": true,
        "selected_text": true,
        "selected_symbol": true,
        "diagnostics": "all",
        "axes": {
            "horizontal": true,
            "vertical": true,
        },
    },

    // Git
    "git_panel": {
        "button": true,
        "dock": "left",
        "default_width": 360,
        "status_style": "label_color",
        "fallback_branch_name": "main",
        "sort_by_path": false,
        "collapse_untracked_diff": false,
        "scrollbar": {
            "show": "never",
        },
        "starts_open": false,
    },

    // Languages
    "languages": {
        "Go": {
            "show_edit_predictions": false,
        },
        "Java": {
            "show_edit_predictions": false,
        },
    },

    // Agents
    "agent": {
        "dock": "right",
        "default_model": {
            "provider": "google",
            "model": "gemini-3-flash-preview",
            "enable_thinking": false,
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "agent_servers": {
        "opencode": {
            "type": "registry",
        },
        "qwen-code": {
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
    },

    // Teminal
    "terminal": {
        "font_size": 12,
        "font_family": "JetBrains Mono",
        "blinking": "on",
    },

    // Fonts
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 14,
    "ui_font_family": "Inter",
    "ui_font_size": 17,
    "ui_font_weight": 300,

    // Themes
    "icon_theme": "Catppuccin Mocha",
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Mocha",
        "dark": "Catppuccin Mocha",
    },

    // Session
    "when_closing_with_no_tabs": "keep_window_open",
    "restore_on_file_reopen": false,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },

    // Other
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "soft_wrap": "editor_width",
    "tab_size": 4,
    "extend_comment_on_newline": false,
    "drag_and_drop_selection": {
        "enabled": false,
    },
    "base_keymap": "Cursor",
    "cursor_blink": true,
    "minimap": {
        "show": "never",
    },
}
