{
    "vim_mode": false,
    "git_panel": {
        "tree_view": false,
    },
    "icon_theme": "Catppuccin Mocha",
    "terminal": {
        "font_size": 11.0,
        "blinking": "on",
        "copy_on_select": true,
    },
    "project_panel": {
        "auto_fold_dirs": false,
    },
    "base_keymap": "Cursor",
    "minimap": {
        "show": "auto",
    },
    "cursor_blink": true,
    "autosave": {
        "after_delay": {
            "milliseconds": 1500,
        },
    },
    "buffer_font_family": "JetBrains Mono",
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "soft_wrap": "editor_width",
    "tab_size": 4,
    "ui_font_size": 16,
    "buffer_font_size": 14.0,
    "theme": {
        "mode": "dark",
        "light": "Gruvbox Light",
        "dark": "Catppuccin Mocha",
    },
    "languages": {
        "C": {
            "show_edit_predictions": false
        },
        "C++": {
            "show_edit_predictions": false
        },
        "Java": {
            "show_edit_predictions": false,
        },
        "Go": {
            "language_servers": ["gopls"],
        },
    },
    "lsp": {
        "gopls": {
            "initialization_options": {
                "env": {
                    "GOROOT": "/home/stepan41k/sdk/go1.26.0",
                    "GOPATH": "/home/stepan41k/go",
                    "PATH": "/home/stepan41k/sdk/go1.26.0/bin:/home/stepan41k/go/bin:/usr/local/bin:/usr/bin",
                },
            },
        },
    },
}
