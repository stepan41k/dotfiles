{
  "icon_theme": "Colored Zed Icons Theme Dark",
  "terminal": {
    "font_size": 11.0,
    "blinking": "on"
  },
  "project_panel": {
    "auto_fold_dirs": false
  },
  "base_keymap": "Cursor",
  "minimap": {
    "show": "auto"
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "JetBrains Mono",
  "auto_indent_on_paste": true,
  "linked_edits": true,
  "soft_wrap": "editor_width",
  "tab_size": 4,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night Storm",
  },
}
